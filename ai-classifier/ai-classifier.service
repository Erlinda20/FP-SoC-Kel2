[Unit]
Description=SOAR AI Classifier Service
After=network.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/ai-classifier
ExecStart=/home/azureuser/ai-classifier/venv/bin/gunicorn \
    --workers 2 \
    --bind 0.0.0.0:5000 \
    app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
